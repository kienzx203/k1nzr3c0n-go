[Unit]
Description=k1nzr3c0n-go (API + workers + scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# HOME must be set so subfinder/uncover + the runner's provider-config writer
# agree on ~/.config (else DB API keys never reach the tools: "subfinder: 1
# provider / uncover: 0"). The binary also sets this at boot as a fallback.
Environment=HOME=/root
Environment=K1NZR3C0N_BASE=/opt/k1nzr3c0n
Environment=K1NZR3C0N_ADDR=:8000
Environment=K1NZR3C0N_WORKERS=2
# PostgreSQL — REQUIRED if you run on Postgres (ARTEX won't serve without its DSN).
# DO NOT drop these when updating the unit. Password '@' must be URL-encoded as %40.
# Environment=ARTEX_PG_DSN=postgres://artex:PASSWORD@127.0.0.1:5432/artex?sslmode=disable
# Environment=K1Z_PG_DSN=postgres://artex:PASSWORD@127.0.0.1:5432/artex?sslmode=disable
# Optional:
# Environment=K1NZR3C0N_API_TOKEN=change-me
# Environment=K1NZR3C0N_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Environment=GITHUB_TOKEN=ghp_...
# Environment=K1NZR3C0N_PROXY_ADDR=127.0.0.1:8083  # recording proxy listen
ExecStart=/opt/k1nzr3c0n/k1nzr3c0n serve
WorkingDirectory=/opt/k1nzr3c0n
Restart=on-failure
RestartSec=3
# Tools install to /usr/local/bin — the service needs write access (or set
# K1NZR3C0N_BIN_DIR to a writable dir on PATH).
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
