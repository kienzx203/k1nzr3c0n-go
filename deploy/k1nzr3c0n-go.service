[Unit]
Description=k1nzr3c0n-go (API + workers + scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=K1NZR3C0N_BASE=/opt/k1nzr3c0n
Environment=K1NZR3C0N_ADDR=:8000
Environment=K1NZR3C0N_WORKERS=2
# Optional:
# Environment=K1NZR3C0N_API_TOKEN=change-me
# Environment=K1NZR3C0N_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Environment=GITHUB_TOKEN=ghp_...
ExecStart=/opt/k1nzr3c0n/k1nzr3c0n serve
WorkingDirectory=/opt/k1nzr3c0n
Restart=on-failure
RestartSec=3
# Tools install to /usr/local/bin — the service needs write access (or set
# K1NZR3C0N_BIN_DIR to a writable dir on PATH).
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
