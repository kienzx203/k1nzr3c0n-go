# Copy to scripts/api-keys.env (gitignored) and fill in your real keys, then run
#   ./scripts/add-api-keys.sh
# Leave a line empty to skip that provider. Do NOT commit the filled-in file.

# Optional: target server + auth (defaults to http://127.0.0.1:8000, no token)
# BASE_URL=http://192.168.52.103:8000
# ARTEX_TOKEN=

# Internet scanners
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
FOFA_KEY=                 # format: email@example.com:API_KEY
NETLAS_KEY=
LEAKIX_KEY=
CRIMINALIP_KEY=

# Subdomain intel
CHAOS_API_KEY=
SECURITYTRAILS_KEY=
VIRUSTOTAL_KEY=
BEVIGIL_KEY=
INTELX_KEY=
DNSDUMPSTER_KEY=
WHOISXMLAPI_KEY=

# Archive / cert
URLSCAN_KEY=
CERTSPOTTER_KEY=
GITHUB_TOKEN=            # ghp_... or github_pat_... (subfinder + gau + github dorking)

# Search / dork
GOOGLE_CSE_KEY=
GOOGLE_CX=
